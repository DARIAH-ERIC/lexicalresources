                  <quote>ヒヤウカクヲ<ruby><rb>央</rb><rt></rt>ヤトフ</ruby>テ<pc>。</pc>送リテ行カシメン</quote>
               </cit>
            </sense>
         </entry>
         <entry  type="main" xml:lang="cmn" xml:id="e8964">
            <form type="phrase">
               <orth>
                  <ruby>
                     <rb xml:id="r2354">
                        <c xml:id="c1">央</c><note>テ</note><metamark>㆓</metamark>
                        <c xml:id="c2">摽</c><metamark place="right">㆐</metamark>
                        <c xml:id="c3">客</c><note>ヲ</note><metamark>㆒</metamark>
                        <c xml:id="c4"><g ref="#hu4_var">護</g></c><note>リ</note><metamark
                           place="left">㆐</metamark>
                        <c xml:id="c5">送</c><note>リ</note><metamark place="left">㆐</metamark>
                        <c xml:id="c6"><g ref="#qu4_var">去</g></c><note>ラシム</note>
                     </rb>
                     <rt place="right" target="#c1" type="pron">ヤン</rt>
                     <rt place="right" target="#c2" type="pron">ピヤ<metamark>◦</metamark>ウ</rt>
                     <rt place="right" target="#c3" type="pron">ケ</rt>
                     <rt place="right" target="#c4" type="pron">ウヽ</rt>
                     <rt place="right" target="#c5" type="pron">ソン</rt>
                     <rt place="right" target="#c6" type="pron">キユイ</rt>
                     <!--gloss is not allowed in lex-0 here but is allowed in p5. should check.-->
                     <rt place="left" from="#c2" to="#c3" type="gloss" xml:lang="ja">山ダチヲ<pc>。</pc>フセグ人ナリ</rt>
                  </ruby>
               </orth>
            </form>
            <sense xml:id="e8964.s1">
               <cit type="translation" xml:lang="ja">
                  <quote>ヒヤウカクヲ<ruby><rb>央</rb><rt/>ヤトフ</ruby>テ<pc>。</pc>送リテ行カシメン</quote>
               </cit>
            </sense>
         </entry>
         issues:
            - the suggested encoding wouldn't be valid in P5 either
            - conceptually speaking, the core of the problem is that the ruby/rb+rt mechanism messes up the
            hierarchical structure of <orth></orth> and <pron></pron> in TEI
