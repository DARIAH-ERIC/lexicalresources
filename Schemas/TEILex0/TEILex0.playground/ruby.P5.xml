         <entry xml:lang="cmn">
            <form type="phrase">
               <ruby>
                  <rb>
                     <orth>
                        <c xml:id="c1">央</c><note>テ</note><metamark>㆓</metamark>
                        <c xml:id="c2">摽</c><metamark place="right">㆐</metamark>
                        <c xml:id="c3">客</c><note>ヲ</note><metamark>㆒</metamark>
                        <c xml:id="c4"><g ref="#hu4_var">護</g></c><note>リ</note><metamark place="left">㆐</metamark>
                        <c xml:id="c5">送</c><note>リ</note><metamark place="left">㆐</metamark>
                        <c xml:id="c6"><g ref="#qu4_var">去</g></c><note>ラシム</note>
                     </orth>
                  </rb>
                  <rt place="right" target="#c1"><pron extent="part" corresp="#c1">ヤン</pron></rt>
                  <rt place="right" target="#c2"><pron extent="part" corresp="#c2">ピヤ<metamark>◦</metamark>ウ</pron></rt>
                  <rt place="right" target="#c3"><pron extent="part" corresp="#c3">ケ</pron></rt>
                  <rt place="right" target="#c4"><pron extent="part" corresp="#c4">ウヽ</pron></rt>
                  <rt place="right" target="#c5"><pron extent="part" corresp="#c5">ソン</pron></rt>
                  <rt place="right" target="#c6"><pron extent="part" corresp="#c6">キユイ</pron></rt>
                  <rt place="left" from="#c2" to="#c3"><gloss xml:lang="ja">山ダチヲ<pc>。</pc>フセグ人ナリ</gloss></rt>
               </ruby>
            </form>
            <sense>
